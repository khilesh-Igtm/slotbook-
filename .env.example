# ==================================================
# Database Configuration
# In Railway: automatically populated from the attached PostgreSQL service
# ==================================================
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/slotbook?schema=public"

# ==================================================
# Authentication & Session Security
# Generate using: openssl rand -base64 32 (min 32 characters required in production)
# Both SESSION_SECRET and JWT_SECRET are accepted.
# ==================================================
SESSION_SECRET="your_production_secret_session_key_min_32_characters"
# JWT_SECRET="your_production_secret_session_key_min_32_characters"

# ==================================================
# Application Base URL (Canonical HTTPS Domain)
# Example: https://slotbook.up.railway.app or https://yourdomain.com
# ==================================================
APP_BASE_URL="http://localhost:3000"
PORT=3000
NODE_ENV="production"

# ==================================================
# Email Delivery Configuration (Resend & Worker)
# Set EMAIL_PROVIDER="resend" in production once API key is provisioned.
# Local development can remain "console".
# ==================================================
EMAIL_PROVIDER="console" # Options: "console" | "resend"
RESEND_API_KEY="re_placeholder_api_key_must_start_with_re_"
EMAIL_FROM="Slotbook <notifications@yourverifieddomain.com>"

# ==================================================
# Notification Background Worker Parameters
# ==================================================
REMINDER_LEAD_HOURS=24
NOTIFICATION_POLL_INTERVAL_MS=5000
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_LOCK_TIMEOUT_MS=300000

# ==================================================
# Host Provisioning & Seed Safety
# In production, automatic seeding is disabled unless explicitly set to "true".
# ==================================================
ALLOW_PRODUCTION_SEED="false"
SEED_HOST_PASSWORD="YourSecureCustomProductionPassword123!"
